# ============================================================
# LOCAL DEVELOPMENT TEMPLATE
#
#   cp config/.env.example config/.env   (then fill in values)
#
# config/.env is git-ignored and excluded from the Docker image.
#
# On EC2 these values come from SSM Parameter Store under
# /bank-ml/prod/<NAME> (see README "Runtime configuration").
#
# Do NOT add AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here for EC2.
# EC2 uses its IAM instance role. Locally, use `aws configure` /
# AWS_PROFILE instead of putting keys in this file.
# ============================================================

# ---------------- AWS ----------------
AWS_REGION=eu-north-1
S3_BUCKET_NAME=<your-s3-bucket>
S3_INPUT_PREFIX=input/
S3_PROCESSED_PREFIX=processed/
S3_OUTPUT_PREFIX=output/

# ---------------- S3 file names ----------------
S3_INPUT_FILE=customer_acquisition_scoring_data.parquet
S3_PROCESSED_FILE=customer_acquisition_features.csv
S3_OUTPUT_FILE=customer_acquisition_predictions.csv

# ---------------- Snowflake ----------------
SNOWFLAKE_ACCOUNT=<account-identifier>
SNOWFLAKE_USER=<user>
SNOWFLAKE_PASSWORD=<password>
SNOWFLAKE_WAREHOUSE=<warehouse>
SNOWFLAKE_DATABASE=<database>
SNOWFLAKE_SCHEMA=<schema>
SNOWFLAKE_ROLE=<role>
SNOWFLAKE_TABLE=<table>

# ---------------- Local files baked into the image ----------------
SOURCE_DATA_FILE=data/customer_acquisition_scoring_data.csv
MODEL_FILE=xgb_customer_acquisition_pipeline.joblib
LOCAL_PROCESSED_FILE=customer_acquisition_features.csv
